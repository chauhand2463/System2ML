FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[all]"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "ui.api:app", "--host", "0.0.0.0", "--port", "8000"]